        "jsCode": "const resultJson = $json.data?.resultJson;\n\nif (!resultJson) {\n  throw new Error('KIE.ai mengembalikan status success tetapi resultJson kosong.');\n}\n\nconst result =\n  typeof resultJson === 'string'\n    ? JSON.parse(resultJson)\n    : resultJson;\n\nconst urls = Array.isArray(result?.resultUrls)\n  ? result.resultUrls\n  : [];\n\nif (urls.length === 0) {\n  throw new Error('KIE.ai mengembalikan success tetapi tidak ada resultUrls.');\n}\n\nreturn [\n  {\n    json: {\n      img1: urls[0] || null,\n      img2: urls[1] || null,\n      img3: urls[2] || null,\n      img4: urls[3] || null,\n      resultUrls: urls\n    }\n  }\n];"
